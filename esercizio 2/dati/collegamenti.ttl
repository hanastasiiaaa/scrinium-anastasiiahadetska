# I collegamenti tra testi e oggetti in RDF (Turtle).
# Prima la scheda di Diluvio Universale e l'oggetto a cui è collegata,
# poi tutti i collegamenti della collezione.

@prefix res:     <https://scrinium.example.org/id/> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix crm:     <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix lrmoo:   <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# La scheda: il testo è un'espressione (LRMoo), descritta con Dublin Core
res:TXT-0001 a lrmoo:F2_Expression ;
    dc:title "Diluvio Universale"@it ;
    dc:creator "Giacomo Leopardi" ;
    dc:date "1810" ;
    dc:subject "infelicità"@it , "dolore"@it , "rinascita"@it ;
    dc:rights "Pubblico dominio" ;
    dcterms:relation res:OGG-0001 .

# L'oggetto collegato: un oggetto prodotto (CIDOC-CRM)
res:OGG-0001 a crm:E22_Human-Made_Object ;
    dc:title "Diluvio Universale"@it ;
    crm:P108i_was_produced_by res:OGG-0001-produzione .

res:OGG-0001-produzione a crm:E12_Production ;
    crm:P14_carried_out_by res:attore-michelangelo-buonarroti ;
    crm:P7_took_place_at res:luogo-citta-del-vaticano .

# Tutti i collegamenti della collezione: una tripla per collegamento
res:TXT-0001 dcterms:relation res:OGG-0001 .   # motivo: il Diluvio universale
res:TXT-0009 dcterms:relation res:OGG-0008 .   # motivo: il melograno
res:TXT-0010 dcterms:relation res:OGG-0010 .   # motivo: il cielo stellato
res:TXT-0004 dcterms:relation res:OGG-0009 .   # evoca: il Mediterraneo
res:TXT-0007 dcterms:relation res:OGG-0016 .   # motivo: lo spazio e il suo limite